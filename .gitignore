# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# Learner-generated build + run artefacts (created at runtime)
workdir/
*.o
a.out

# Local secrets and machine-specific config
.env
config.local.json

# The learner's own exam papers and question banks.
#
# These are the learner's material, not ours: past papers and question
# banks are not ours to redistribute, and the app's question bank is built
# from them locally rather than shipped. They must not end up in the
# repository.
examprep/
examprep for srm ktr/

# The learner's own copies of textbooks. The app reads them from disk - the
# Theory Book's "Open in book" button opens the PDF at the right page - but
# a copyrighted book is not ours to put in the repository.
theory/**/*.pdf

# Stock design references, not part of the application source
admin-dashboard-panel-with-gradient-style/
dashboard-user-panel-template/
*.zip

# Android / Gradle build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/*.iml
android/app/*.iml
*.apk
*.aab
*.ap_
*.dex

# Editor and tool backups
*.bak
*.orig
*.rej
