<?xml version="1.0" encoding="utf-8"?>
<!--
  Simple vector launcher icon: an anvil-ish block with a spark, matching the
  "smith" metaphor of the app name. Kept as a vector so no binary assets are
  committed and it scales to every density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#1E1E1E"
        android:pathData="M0,0h108v108h-108z" />

    <!-- anvil base -->
    <path
        android:fillColor="#4FC1FF"
        android:pathData="M30,66h48v6h-48z" />
    <path
        android:fillColor="#4FC1FF"
        android:pathData="M40,72h28v6h-28z" />

    <!-- anvil body and horn -->
    <path
        android:fillColor="#569CD6"
        android:pathData="M26,60h40c0,0 8,-2 14,-8c0,8 -6,16 -18,16h-36z" />

    <!-- spark -->
    <path
        android:fillColor="#CE9178"
        android:pathData="M70,30l4,10l10,4l-10,4l-4,10l-4,-10l-10,-4l10,-4z" />
</vector>