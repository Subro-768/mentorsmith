<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8+).

  The full-bleed square goes in the background layer; the anvil and spark go
  in the foreground, scaled into the inner 72dp safe zone so the launcher mask
  never clips the horn.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
